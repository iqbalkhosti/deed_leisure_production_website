# ── Email delivery (Vercel → Project → Settings → Environment Variables) ──────
# Without these the contact and mockup forms still work: they return a clear
# message and offer the visitor a mailto link instead, so no enquiry is lost.

# Resend API key — https://resend.com → API Keys
RESEND_API_KEY=re_...

# Verified sender. The domain must be verified in Resend.
MAIL_FROM=Deed Leisure <hello@deedleisure.ca>

# Where enquiries are delivered. Defaults to CONTACT_EMAIL when unset.
MAIL_TO=info@deedleisure.ca

# Public address shown in fallback messages.
CONTACT_EMAIL=info@deedleisure.ca

# ── Build (optional) ─────────────────────────────────────────────────────────
# Base URL used when generating sitemap.xml. Defaults to https://deedleisure.ca
SITE_URL=https://deedleisure.ca
